# ============================================================
# MISSINGLINK AI - Environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- PostgreSQL -------------------------------------------------
POSTGRES_DB=missinglink
POSTGRES_USER=missinglink
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# --- Backend (Spring Boot) --------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/missinglink
SPRING_DATASOURCE_USERNAME=missinglink
SPRING_DATASOURCE_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-64-characters-minimum-random-hex-string-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ACCESS_TOKEN_TTL_MS=900000            # 15 min
JWT_REFRESH_TOKEN_TTL_MS=604800000        # 7 days
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=change-me-ai-gateway-key
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  # 64 hex chars (AES-256)
STORAGE_ROOT=./storage
STORAGE_PROVIDER=local                       # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=console                      # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@missinglink.local
PUBLIC_CASE_URL_EXPIRE_MINUTES=15
RATE_LIMIT_PER_MINUTE=60
DATA_RETENTION_DAYS=365
MFA_REQUIRED=false

# --- AI Service (FastAPI) ----------------------------------------
AI_PORT=8000
AI_MODEL_FACE=auto                         # auto | insightface | opencv | none
AI_MODEL_EMBEDDING=auto                    # auto | clip | opencv-histogram | none
AI_MODEL_OBJECT=auto                       # auto | yolo | none
AI_FALLBACK_ALLOWED=true                   # use deterministic mock models when CUDA/models absent
AI_VECTOR_DIM=512

# --- Redis (rate limiting / realtime) -----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Frontend (Next.js) -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAPBOX_TOKEN=                   # optional
