# SKYGUARD AI - Environment Configuration
# Copy to .env and modify as needed

# Application
APP_NAME=SKYGUARD AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database
DATABASE_URL=sqlite+aiosqlite:///./skyguard.db
DATABASE_ECHO=false

# Simulator
SIMULATOR_STATIONS=8
SIMULATOR_INTERVAL_SECONDS=1
SIMULATOR_START_DATE=2026-01-01
SIMULATOR_DAYS=30

# Model Paths
MODEL_DIR=./models
MODEL_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]