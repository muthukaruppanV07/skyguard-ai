{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bhashasetu.sample.schema.v1",
  "title": "BhashaSetu sample record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id", "domain", "status", "created_at", "version",
    "gloss_seq", "signer", "consent", "labels", "qa"
  ],
  "properties": {
    "sample_id": { "type": "string", "pattern": "^ISL-(PDS|HTH|LEG)-\\d{5}$" },
    "domain": { "enum": ["pds", "health", "legal"] },
    "status": { "enum": ["registered", "labeled", "consensus", "qa_pass", "qa_reject", "withdrawn"] },
    "created_at": { "type": "string", "format": "date-time" },
    "version": { "type": "string" },
    "gloss_seq": {
      "type": "array", "items": { "type": "string" },
      "description": "Canonical gloss sequence (signing order, after consensus)."
    },
    "english_sentence": {
      "type": ["string", "null"],
      "description": "NLG target sentence (filled from consensus english)."
    },
    "dialect": {
      "type": "object",
      "properties": {
        "region": { "type": "string" },
        "variant_notes": { "type": "string" }
      },
      "required": ["region"]
    },
    "video": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "relative to data/raw" },
        "duration_s": { "type": "number" },
        "fps": { "type": "number" },
        "source_kind": { "enum": ["recorded", "sourced"] }
      }
    },
    "keypoints": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "relative to data/keypoints" },
        "frame_count": { "type": "integer" },
        "checksum_sha256": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["islrtc", "nishtha", "youtube", "community", "self-recorded", "other"] },
        "source_id": { "type": "string" },
        "url": { "type": "string" },
        "provenance_notes": { "type": "string" }
      }
    },
    "signer": {
      "type": "object",
      "required": ["anon_id", "region"],
      "properties": {
        "anon_id": { "type": "string", "pattern": "^S-\\d{3,}$" },
        "region": { "type": "string" },
        "age_group": { "type": "string" },
        "gender": { "type": "string" },
        "handedness": { "type": "string" },
        "native_sign_language": { "type": "boolean" }
      }
    },
    "consent": {
      "type": "object",
      "required": ["status", "form_id"],
      "properties": {
        "status": { "enum": ["granted", "pending", "withdrawn"] },
        "form_id": { "type": "string" },
        "usage": { "type": "array", "items": { "type": "string" } }
      }
    },
    "labels": {
      "type": "array",
      "description": "Annotator label submissions (voting).",
      "items": {
        "type": "object",
        "required": ["annotator", "gloss", "ts"],
        "properties": {
          "annotator": { "type": "string" },
          "gloss": { "type": "string" },
          "english_sentence": { "type": "string" },
          "region": { "type": "string" },
          "dialect_notes": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "flags": { "type": "array", "items": { "type": "string" } },
          "ts": { "type": "string", "format": "date-time" }
        }
      }
    },
    "consensus": {
      "type": ["object", "null"],
      "properties": {
        "gloss": { "type": "string" },
        "english_sentence": { "type": "string" },
        "annotator_count": { "type": "integer" },
        "agreement": { "type": "number" },
        "threshold": { "type": "number" },
        "status": { "enum": ["agreed", "ambiguous", "needs_voting"] }
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pending", "passed", "rejected"] },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" },
        "ts": { "type": "string", "format": "date-time" }
      }
    }
  }
}