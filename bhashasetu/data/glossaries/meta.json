{
  "schema_version": "1.0.0",
  "description": "Shared glossary schema + region codes for BhashaSetu domain vocabularies.",
  "entry_schema": {
    "id": "unique entry id, prefixed by domain",
    "gloss": "canonical ISL gloss, hyphenated multi-word ok",
    "english": "English head word/phrase",
    "category": "category key from this file",
    "aliases": ["community synonyms and alternate sign productions"],
    "fingerspelled": false,
    "sign_notes": "production notes for labelers; which handshape/motion/placement per observed ISL",
    "regional_variants": [{ "region": "region code", "note": "observed dialect difference" }],
    "source_ref": "provenance source id from data/sourced/sources.csv",
    "verified": false
  },
  "domains": {
    "pds":    { "label": "Public Distribution System", "size_target": "500-1000 signs", "categories": ["document", "item", "quantity", "procedure", "action", "person", "place", "question"] },
    "health": { "label": "Health / Hospital",             "size_target": "500-1000 signs", "categories": ["symptom", "body_part", "medicine", "facility", "service", "action", "facility_word", "person", "condition", "question", "emergency"] },
    "legal":  { "label": "Courts / Legal Aid",            "size_target": "500-1000 signs", "categories": ["person", "document", "procedure", "action", "place", "offence", "rights", "question"] }
  },
  "regions": [
    { "code": "delhi",     "label": "Delhi / NCR (ISLRTЦC standard)" },
    { "code": "mumbai",    "label": "Maharashtra / Mumbai" },
    { "code": "kolkata",   "label": "West Bengal / Kolkata" },
    { "code": "chennai",   "label": "Tamil Nadu / Chennai" },
    { "code": "bengaluru", "label": "Karnataka / Bengaluru" },
    { "code": "hyderabad", "label": "Telangana / Hyderabad" },
    { "code": "lucknow",   "label": "Uttar Pradesh / Lucknow" },
    { "code": "patna",     "label": "Bihar / Patna" },
    { "code": "gujarat",   "label": "Gujarat" },
    { "code": "punjab",    "label": "Punjab / Haryana" },
    { "code": "kerala",    "label": "Kerala" },
    { "code": "odisha",    "label": "Odisha" },
    { "code": "northeast", "label": "North-East states" },
    { "code": "central",   "label": "Madhya Pradesh / central" },
    { "code": "jammu",     "label": "Jammu & Kashmir" }
  ],
  "rules": {
    "gloss_format": "lowercase, hyphen between words: 'ration-card', 'gas-cylinder'",
    "fingerspell_policy": "proper nouns and brand-new terms fingerspelled until a community sign is documented; mark fingerspelled=true",
    "coverage_target": ">=5 clips per sign per region; >=2 annotators per clip; OSV order recorded verbatim",
    "versioning": "bump dataset_version only via manifest release; never edit shipped manifests"
  }
}